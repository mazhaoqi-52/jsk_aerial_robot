<?xml version="1.0"?>
<launch>
  ###########  launch config  ###########
  <arg name="real_machine" default="False"/>
  <arg name="simulation"   default="True"/>

  ###########  Force sensor ground truth  ###########
  <arg name="force_sensor_enabled" default="true"
       doc="Start CFS force sensor for ground-truth logging only; it is not used by control"/>
  <arg name="force_sensor" default="PFS055YA501U6"
       doc="Force sensor config under cfs_sensor/config"/>
  <arg name="force_sensor_port" default="/dev/ttyACM0"
       doc="Serial device for the CFS force sensor"/>
  <arg name="force_sensor_auto_calib" default="true"
       doc="Automatically zero the CFS force sensor once after startup"/>
  <arg name="force_sensor_auto_calib_delay" default="0.5"
       doc="Extra settling time after the first force sensor sample before calibration"/>
  <arg name="force_sensor_auto_calib_timeout" default="10.0"
       doc="Timeout for waiting for the calibration service and first force sensor sample"/>

  <include if="$(arg force_sensor_enabled)"
           file="$(find beetle)/launch/aerial_pushing_tasks/force_sensor_test.launch">
    <arg name="force_sensor"                    value="$(arg force_sensor)"/>
    <arg name="force_sensor_port"               value="$(arg force_sensor_port)"/>
    <arg name="force_sensor_auto_calib"         value="$(arg force_sensor_auto_calib)"/>
    <arg name="force_sensor_auto_calib_delay"   value="$(arg force_sensor_auto_calib_delay)"/>
    <arg name="force_sensor_auto_calib_timeout" value="$(arg force_sensor_auto_calib_timeout)"/>
  </include>

  ###########  Formation modules  ###########
  <arg name="module_ids" default="2,3,1"
       doc="Comma-separated beetle module IDs, e.g. 2,3 or 2,3,1"/>

  ###########  Wall  ###########
  <arg name="wall_ns"        default="wall"/>
  <arg name="wall_id"        default="55"/>
  <arg name="wall_x"         default="1.5"/>
  <arg name="wall_y"         default="0"/>
  <arg name="wall_z"         default="0"/>
  <arg name="wall_yaw"       default="0"/>
  <arg name="wall_thickness" default="0.1"/>
  <arg name="wall_width"     default="2.0"/>
  <arg name="wall_height"    default="2.0"/>
  <arg name="wall_mass"      default="20.0"/>
  <arg name="use_wall_mocap" default="false"
       doc="Use wall mocap pose; false means +x/stall-only contact is enough"/>
  <arg name="use_wall_wrench" default="false"
       doc="Use /wall/wrench for contact detection; force sensor /cfs/data remains logging-only"/>

  <include file="$(find beetle)/launch/aerial_pushing_tasks/wall_pos.launch">
    <arg name="real_machine"   value="$(arg real_machine)"/>
    <arg name="simulation"     value="$(arg simulation)"/>
    <arg name="robot_ns"       value="$(arg wall_ns)"/>
    <arg name="robot_id"       value="$(arg wall_id)"/>
    <arg name="wall_id"        value="$(arg wall_id)"/>
    <arg name="wall_x"         value="$(arg wall_x)"/>
    <arg name="wall_y"         value="$(arg wall_y)"/>
    <arg name="wall_z"         value="$(arg wall_z)"/>
    <arg name="wall_yaw"       value="$(arg wall_yaw)"/>
    <arg name="wall_thickness" value="$(arg wall_thickness)"/>
    <arg name="wall_width"     value="$(arg wall_width)"/>
    <arg name="wall_height"    value="$(arg wall_height)"/>
    <arg name="wall_mass"      value="$(arg wall_mass)"/>
    <arg name="use_wall_mocap" value="$(arg use_wall_mocap)"/>
  </include>

  ###########  Parameters  ###########
  <arg name="push_direction" default="+x"
       doc="auto, +x, -x, +y, -y, or a comma-separated vector"/>
  <arg name="approach_distance" default="0.8"
       doc="Max forward distance before contact timeout (m)"/>
  <arg name="approach_speed" default="0.03"
       doc="Forward approach speed (m/s)"/>
  <arg name="approach_overrun" default="0.12"
       doc="Extra commanded travel past the estimated wall face (m)"/>
  <arg name="contact_wrench_threshold" default="0.8"
       doc="Wall wrench threshold for contact detection (N)"/>
  <arg name="push_force" default="5.0"
       doc="Target pushing force feedforward (N)"/>
  <arg name="force_ramp_time" default="3.0"
       doc="S-curve force ramp time (s)"/>
  <arg name="push_duration" default="3.0"
       doc="Total pushing hold duration including ramp (s)"/>
  <arg name="full_force_hold_time" default="0.0"
       doc="Minimum time to hold after push_force is reached (s)"/>
  <arg name="push_position_lead" default="0.03"
       doc="Small position lead into the wall to maintain contact (m)"/>
  <arg name="retreat_after_push" default="true"/>
  <arg name="retreat_distance" default="0.20"/>
  <arg name="debug" default="false"/>

  ###########  Demo  ###########
  <node name="formation_wall_pushing" pkg="beetle" type="wall_pushing_formation.py"
        output="screen">
    <param name="module_ids"               value="$(arg module_ids)"/>
    <param name="simulation"               value="$(arg simulation)"/>
    <param name="real_machine"             value="$(arg real_machine)"/>
    <param name="debug"                    value="$(arg debug)"/>

    <param name="wall_x"                   value="$(arg wall_x)"/>
    <param name="wall_y"                   value="$(arg wall_y)"/>
    <param name="wall_z"                   value="$(arg wall_z)"/>
    <param name="wall_yaw"                 value="$(arg wall_yaw)"/>
    <param name="wall_thickness"           value="$(arg wall_thickness)"/>
    <param name="wall_width"               value="$(arg wall_width)"/>
    <param name="wall_height"              value="$(arg wall_height)"/>
    <param name="use_wall_mocap"           value="$(arg use_wall_mocap)"/>
    <param name="use_wall_wrench"          value="$(arg use_wall_wrench)"/>

    <param name="push_direction"           value="$(arg push_direction)"/>
    <param name="approach_distance"        value="$(arg approach_distance)"/>
    <param name="approach_speed"           value="$(arg approach_speed)"/>
    <param name="approach_overrun"         value="$(arg approach_overrun)"/>
    <param name="contact_wrench_threshold" value="$(arg contact_wrench_threshold)"/>
    <param name="push_force"               value="$(arg push_force)"/>
    <param name="force_ramp_time"          value="$(arg force_ramp_time)"/>
    <param name="push_duration"            value="$(arg push_duration)"/>
    <param name="full_force_hold_time"     value="$(arg full_force_hold_time)"/>
    <param name="push_position_lead"       value="$(arg push_position_lead)"/>
    <param name="retreat_after_push"       value="$(arg retreat_after_push)"/>
    <param name="retreat_distance"         value="$(arg retreat_distance)"/>
  </node>
</launch>
