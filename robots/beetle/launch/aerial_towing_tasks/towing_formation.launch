<?xml version="1.0"?>
<launch>
  <!-- Environment settings -->
  <arg name="real_machine" default="false"/>
  <arg name="simulation" default="true"/>

  <!-- Formation parameters -->
  <arg name="module_ids" default="2,3,1" />
  
  <!-- Load parameters -->
  <arg name="load_ns" default="load"/>
  <arg name="load_id" default="86"/>
  <arg name="load_x" default="3"/>
  <arg name="load_y" default="0"/>
  <arg name="load_z" default="0"/>
  <arg name="load_yaw" default="0"/>
  <arg name="load_friction" default="0.5"/>
  
  <!-- Towing parameters -->
  <arg name="towing_distance" default="1.0"/> <!-- meters -->
  <arg name="towing_force" default="5.0"/> <!-- Newtons -->
  
  <!-- Debug mode -->
  <arg name="debug" default="false" />
  
  <!-- Unified control mode: LEADER allocates for all N*4 rotors -->
  <arg name="unified_control_mode" default="false" />
  
  <!-- Include load position setup -->
  <include file="$(find beetle)/launch/aerial_towing_tasks/load_pos.launch">
    <arg name="real_machine" value="$(arg real_machine)" />
    <arg name="simulation" value="$(arg simulation)" />
    <arg name="robot_ns" value="$(arg load_ns)" />
    <arg name="load_id" value="$(arg load_id)"/>
    <arg name="load_x" value="$(arg load_x)" />
    <arg name="load_y" value="$(arg load_y)" />
    <arg name="load_z" value="$(arg load_z)" />
    <arg name="load_yaw" value="$(arg load_yaw)" />
    <arg name="load_friction" value="$(arg load_friction)" />
  </include>
  
  <!-- Controller parameters for formation towing -->
  <!-- Set unified_control_mode for each module namespace.
       The YAML config (BeetleControl_sim.yaml) provides default=false.
       This overrides it per-module at launch time. -->
  <group if="$(eval len(arg('module_ids').split(',')) > 0)">
    <param name="/beetle$(eval arg('module_ids').split(',')[0].strip())/controller/unified_control_mode" value="$(arg unified_control_mode)" />
  </group>
  <group if="$(eval len(arg('module_ids').split(',')) > 1)">
    <param name="/beetle$(eval arg('module_ids').split(',')[1].strip())/controller/unified_control_mode" value="$(arg unified_control_mode)" />
  </group>
  <group if="$(eval len(arg('module_ids').split(',')) > 2)">
    <param name="/beetle$(eval arg('module_ids').split(',')[2].strip())/controller/unified_control_mode" value="$(arg unified_control_mode)" />
  </group>
  <param name="controller/towing_feedforward/enabled" value="true" />
  <param name="controller/towing_feedforward/force_x" value="$(arg towing_force)" />
  
  <!-- Assembly CoG publisher node -->
  <node name="assembly_cog_publisher" pkg="beetle" type="assembly_cog_publisher.py"
        output="screen">
    <param name="module_ids" value="$(arg module_ids)" />
    <param name="publish_rate" value="50.0" />
    <param name="timeout_threshold" value="0.5" />
  </node>
  
  <!-- Formation load towing node -->
  <node name="formation_load_towing" pkg="beetle" type="load_towing_formation.py"
        output="screen" cwd="node">
    <param name="module_ids" value="$(arg module_ids)" />
    <param name="towing_distance" value="$(arg towing_distance)" />
    <param name="towing_force" value="$(arg towing_force)" />
    <param name="simulation" value="$(arg simulation)" />
    <param name="real_machine" value="$(arg real_machine)" />
    <param name="debug" value="$(arg debug)" />
  </node>
</launch>
