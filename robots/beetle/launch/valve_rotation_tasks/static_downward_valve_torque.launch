<?xml version="1.0"?>
<launch>
  <!-- Static valve test: circular contact search, 6D wrench ramp/hold/unload. -->
  <arg name="real_machine" default="false"/>
  <arg name="simulation" default="true"/>
  <arg name="module_ids" default="1,2"/>
  <arg name="end_effector_module_id"
       default="$(eval str(arg('module_ids')).replace(' ', '').split(',')[-1])"/>

  <!-- Real-machine valve pose source. Simulation keeps using the valve model
       spawned by n_module_test.launch, avoiding a duplicate Gazebo model. -->
  <arg name="valve_ns" default="valve"/>
  <arg name="valve_id" default="85"/>
  <arg name="valve_feedback_timeout" default="10.0"
       doc="Seconds to wait for valve mocap before using the current end-effector centre"/>
  <arg name="pose_feedback_max_age" default="0.5"
       doc="Maximum age of valve and module pose feedback accepted at initialization"/>

  <include if="$(arg real_machine)"
           file="$(find beetle)/launch/valve_rotation_tasks/valve_pos.launch">
    <arg name="real_machine" value="$(arg real_machine)"/>
    <arg name="simulation" value="$(arg simulation)"/>
    <arg name="robot_ns" value="$(arg valve_ns)"/>
    <arg name="valve_id" value="$(arg valve_id)"/>
  </include>

  <!-- Hardware CFS ground truth. Calibration is performed synchronously by
       the static task before it is allowed to start the contact search. -->
  <arg name="force_sensor_enabled" default="true"/>
  <arg name="force_sensor" default="PFS055YA501U6"/>
  <arg name="force_sensor_port" default="/dev/ttyACM0"/>
  <arg name="force_sensor_auto_calib" default="true"/>
  <arg name="force_sensor_auto_calib_delay" default="0.5"/>
  <arg name="force_sensor_auto_calib_timeout" default="10.0"/>
  <arg name="force_sensor_data_max_age" default="0.5"/>
  <arg name="force_sensor_topic" default="cfs/data"/>
  <arg name="force_sensor_calib_service" default="cfs_sensor_calib"/>

  <group if="$(arg force_sensor_enabled)">
    <group if="$(arg real_machine)">
      <include unless="$(arg simulation)"
               file="$(find beetle)/launch/aerial_pushing_tasks/force_sensor_test.launch">
        <arg name="force_sensor" value="$(arg force_sensor)"/>
        <arg name="force_sensor_port" value="$(arg force_sensor_port)"/>
        <!-- The task owns calibration sequencing; do not race a second helper. -->
        <arg name="force_sensor_auto_calib" value="false"/>
      </include>
    </group>
  </group>

  <arg name="rotation_direction" default="cw" doc="cw or ccw"/>
  <arg name="rotation_view" default="below" doc="above or below"/>

  <!-- Downward dual-pin midpoint relative to the selected host UAV fc. The
       formation-CoG offset is derived from module_ids and EE host selection. -->
  <arg name="tool_center_x" default="0.240"/>
  <arg name="tool_center_y" default="0.0"/>
  <arg name="tool_center_z" default="0.11053"/>

  <!-- Only the quantities required to define angular stall contact. -->
  <arg name="contact_search_speed_deg_s" default="3.0"/>
  <arg name="contact_search_ramp_time" default="2.0"
       doc="Seconds to smoothstep the circular-search angular speed from zero to its target"/>
  <arg name="contact_center_tolerance" default="0.100"
       doc="Maximum EE-to-valve XY offset in metres accepted after manual insertion"/>
  <arg name="contact_search_max_angle_deg" default="45.0"/>
  <arg name="contact_min_search_angle_deg" default="2.0"/>
  <arg name="contact_stall_lead_deg" default="3.0"/>
  <arg name="contact_stall_velocity_deg_s" default="0.5"/>
  <arg name="contact_velocity_window" default="0.4"/>
  <arg name="contact_required_cycles" default="8"/>

  <!-- Application-point wrench in world coordinates. Tz receives the visual
       rotation sign; all six components are shifted to the formation CoG. -->
  <arg name="feedforward_force_x" default="0.0"/>
  <arg name="feedforward_force_y" default="0.0"/>
  <arg name="feedforward_force_z" default="5.0"/>
  <arg name="feedforward_torque_x" default="0.0"/>
  <arg name="feedforward_torque_y" default="0.0"/>
  <arg name="target_torque" default="1.0"/>
  <arg name="wrench_ramp_time" default="3.0"/>
  <arg name="full_torque_hold_time" default="3.0"/>
  <arg name="unload_min_duration" default="2.0"/>
  <arg name="wrench_force_rate" default="3.0"/>
  <arg name="wrench_torque_rate" default="0.5"/>

  <node name="static_downward_valve_torque" pkg="beetle"
        type="static_downward_valve_torque.py" output="screen">
    <param name="real_machine" value="$(arg real_machine)"/>
    <param name="simulation" value="$(arg simulation)"/>
    <param name="module_ids" value="$(arg module_ids)"/>
    <param name="end_effector_module_id" value="$(arg end_effector_module_id)"/>
    <param name="valve_feedback_timeout" value="$(arg valve_feedback_timeout)"/>
    <param name="pose_feedback_max_age" value="$(arg pose_feedback_max_age)"/>
    <param name="rotation_direction" value="$(arg rotation_direction)"/>
    <param name="rotation_view" value="$(arg rotation_view)"/>
    <param name="tool_center_x" value="$(arg tool_center_x)"/>
    <param name="tool_center_y" value="$(arg tool_center_y)"/>
    <param name="tool_center_z" value="$(arg tool_center_z)"/>
    <param name="force_sensor_enabled" value="$(arg force_sensor_enabled)"/>
    <param name="force_sensor_auto_calib" value="$(arg force_sensor_auto_calib)"/>
    <param name="force_sensor_auto_calib_delay" value="$(arg force_sensor_auto_calib_delay)"/>
    <param name="force_sensor_auto_calib_timeout" value="$(arg force_sensor_auto_calib_timeout)"/>
    <param name="force_sensor_data_max_age" value="$(arg force_sensor_data_max_age)"/>
    <param name="force_sensor_topic" value="$(arg force_sensor_topic)"/>
    <param name="force_sensor_calib_service" value="$(arg force_sensor_calib_service)"/>
    <param name="contact_search_speed_deg_s" value="$(arg contact_search_speed_deg_s)"/>
    <param name="contact_search_ramp_time" value="$(arg contact_search_ramp_time)"/>
    <param name="contact_center_tolerance" value="$(arg contact_center_tolerance)"/>
    <param name="contact_search_max_angle_deg" value="$(arg contact_search_max_angle_deg)"/>
    <param name="contact_min_search_angle_deg" value="$(arg contact_min_search_angle_deg)"/>
    <param name="contact_stall_lead_deg" value="$(arg contact_stall_lead_deg)"/>
    <param name="contact_stall_velocity_deg_s" value="$(arg contact_stall_velocity_deg_s)"/>
    <param name="contact_velocity_window" value="$(arg contact_velocity_window)"/>
    <param name="contact_required_cycles" value="$(arg contact_required_cycles)"/>
    <param name="feedforward_force_x" value="$(arg feedforward_force_x)"/>
    <param name="feedforward_force_y" value="$(arg feedforward_force_y)"/>
    <param name="feedforward_force_z" value="$(arg feedforward_force_z)"/>
    <param name="feedforward_torque_x" value="$(arg feedforward_torque_x)"/>
    <param name="feedforward_torque_y" value="$(arg feedforward_torque_y)"/>
    <param name="target_torque" value="$(arg target_torque)"/>
    <param name="wrench_ramp_time" value="$(arg wrench_ramp_time)"/>
    <param name="full_torque_hold_time" value="$(arg full_torque_hold_time)"/>
    <param name="unload_min_duration" value="$(arg unload_min_duration)"/>
    <param name="wrench_force_rate" value="$(arg wrench_force_rate)"/>
    <param name="wrench_torque_rate" value="$(arg wrench_torque_rate)"/>
  </node>
</launch>
