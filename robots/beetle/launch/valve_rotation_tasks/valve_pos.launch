<?xml version="1.0"?>
<launch>
  <arg name="real_machine" default="true" />
  <arg name="simulation" default="false" />
  <arg name="robot_ns" default="valve" />
  <arg name="valve_id" default="85" />
  <arg name="robot_id" default="1" />
  <arg name="valve_model" default="valve_downward"
       doc="valve or valve_downward" />
  <arg name="valve_support_height" default="1.5"
       doc="Downward-valve support beam height above ground (m)" />
  ## valve position in gazebo ##
  <arg name="valve_x" default="3" />
  <arg name="valve_y" default="0" />
  <arg name="valve_z" default="0" />
  <arg name="valve_yaw" default="0" />
  <group ns="$(arg robot_ns)">
    <group if="$(arg real_machine)">
      <group unless="$(arg simulation)">
        <include file="$(find aerial_robot_base)/launch/external_module/mocap.launch">
          <arg name="robot_id" value="$(arg valve_id)" />
        </include>
      </group>
    </group>
    <group if="$(arg simulation)">
      <group unless="$(arg real_machine)">
        <param name="robot_description"
          command="$(find xacro)/xacro $(find beetle)/urdf/valve.urdf no_collision:=false"
          if="$(eval arg('valve_model') == 'valve')" />
        <param name="robot_description"
          command="$(find xacro)/xacro $(find beetle)/urdf/valve_downward.urdf support_height:=$(arg valve_support_height) no_collision:=false"
          if="$(eval arg('valve_model') == 'valve_downward')" />
        <!-- Spawn valve directly, ignore if it already exists -->
        <node pkg="gazebo_ros" type="spawn_model" name="spawn_valve" respawn="false" output="screen"
          args="-urdf -model $(arg valve_model) -x $(arg valve_x) -y $(arg valve_y) -z $(arg valve_z) -Y $(arg valve_yaw) -param robot_description" />
      </group>
    </group>
  </group>
</launch>
