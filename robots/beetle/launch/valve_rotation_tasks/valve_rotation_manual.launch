<?xml version="1.0"?>
<launch>
    <!-- UAV Module ID -->
    <arg name="module_id" default="1" />
    <arg name="real_machine" default="true"/>
    <arg name="simulation" default="false" />
    <arg name="valve_ns" default="valve"/>
    <arg name="valve_id" default="1"/>
    <arg name="valve_x" default="3"/>
    <arg name="valve_y" default="0"/>
    <arg name="valve_yaw" default="0"/>
    <!-- Control parameters -->
    <arg name="rotation_angle" default="1.5708" />  <!-- 90 degrees in radians -->
    <arg name="rotation_speed" default="0.05" />     <!-- 0.05 m/s as requested -->
    <arg name="preview_only" default="false" />      <!-- Preview mode: only show trajectory -->
    <arg name="preview_duration" default="30.0" />   <!-- Preview duration in seconds -->
    
    <!-- Visualization options -->
    <arg name="rviz" default="false" />
    <arg name="rviz_config" default="$(find beetle)/config/valve_rotation_visualization.rviz" />
    
  <include file="$(find beetle)/launch/valve_rotation_tasks/valve_pos.launch">
    <arg name="real_machine" value="$(arg real_machine)" />
    <arg name="simulation" value="$(arg simulation)" />
    <arg name="robot_ns" value="$(arg valve_ns)" />
    <arg name="robot_id" value="$(arg valve_id)"/>
    <arg name="valve_x" value="$(arg valve_x)" />
    <arg name="valve_y" value="$(arg valve_y)" />
    <arg name="valve_yaw" value="$(arg valve_yaw)" />
  </include>
    <!-- Valve rotation controller node -->
    <node name="valve_rotation_controller" pkg="beetle" type="valve_rotation_fang_single_joy.py" 
          output="screen" respawn="false">
        <param name="module_id" value="$(arg module_id)" />
        <param name="rotation_angle" value="$(arg rotation_angle)" />
        <param name="rotation_speed" value="$(arg rotation_speed)" />
        <param name="auto_start" value="true" />
        <param name="preview_only" value="$(arg preview_only)" />
        <param name="preview_duration" value="$(arg preview_duration)" />
        <param name="simulation" value="$(arg simulation)" />
        
        <!-- Control parameters for strict trajectory following -->
        <param name="feedback_frequency" value="30" />
        <param name="position_tolerance" value="0.015" />
        <param name="yaw_tolerance" value="0.02" />
        
        <!-- Position control gains (reduced for smoother motion) -->
        <param name="distance_control_gain" value="0.3" />
        <param name="position_control_gain" value="0.3" />
        <param name="yaw_control_gain" value="0.2" />
        
        <!-- Safety parameters -->
        <param name="distance_tolerance" value="0.01" />
        <param name="max_position_correction" value="0.02" />
        <param name="max_yaw_correction" value="0.05" />
    </node>
    
    <!-- RViz for trajectory visualization -->
    <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz" 
          args="-d $(arg rviz_config)" output="screen" />
    
</launch>
